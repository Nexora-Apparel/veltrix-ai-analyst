# Copy to .env locally. Never commit the populated .env file.
# Reuse the established VELTRIX Community credential name where available.
FIVEDOLLARFOOTBALL_COMMUNITY_API_KEY=
# Optional fallback for a standard 5Dollar key:
FIVEDOLLARFOOTBALL_API_KEY=

# Private PostgreSQL connection; never commit a populated value.
DATABASE_URL=
EXPECTED_DATABASE_NAME=veltrix_ai_analyst
ALLOW_REMOTE_MIGRATIONS=false
